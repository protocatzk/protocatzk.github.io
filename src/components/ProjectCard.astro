---
import type { Lang } from '../i18n/ui';
import { formatDate, useTranslations } from '../i18n/utils';
import { languageColor } from '../lib/languages';
import type { Project } from '../lib/projects';

interface Props {
	project: Project;
	index: number;
	lang: Lang;
	variant?: 'flagship' | 'feature';
}

const { project, index, lang, variant = 'feature' } = Astro.props;
const t = useTranslations(lang);
const dotColor = languageColor(project.language);
---

<a class:list={['project-card', variant]} href={project.url}>
	<div class="card-top">
		<span class="card-index">{String(index).padStart(2, '0')}</span>
		{
			project.language && (
				<span class="card-lang">
					<span class="lang-dot" style={`--dot: ${dotColor}`} aria-hidden="true" />
					{project.language}
				</span>
			)
		}
	</div>

	<h3 class="card-title">{project.title}</h3>
	<p class="card-desc">{project.description}</p>

	{
		project.tags.length > 0 && (
			<ul class="card-tags">
				{project.tags.map((tag) => (
					<li>{tag}</li>
				))}
			</ul>
		)
	}

	<div class="card-foot">
		<span class="meta">
			<span>{t('projects.updated')} {formatDate(project.updatedAt, lang)}</span>
			{
				project.stars > 0 && (
					<span>★ {project.stars} {t('projects.stars')}</span>
				)
			}
		</span>
		<span class="open">{t('projects.open')} ↗</span>
	</div>
</a>
